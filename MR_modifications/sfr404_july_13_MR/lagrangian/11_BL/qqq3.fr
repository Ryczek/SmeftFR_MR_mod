(* SmeftFR v4.0 - class 11 (dim-5/6 B/L violating) operator: qqq3 *)

LQqqq3 := Module[{sp1,sp2,ff1,ff2,ff3,ff4,aa,bb,cc,jj,kk,mm,nn,aux1,aux2},

aux1 = ExpandIndices[ ToExpression[SMEFT$WB <> "qqq3"][ff1,ff2,ff3,ff4]
  Xqqq[mm,nn,ff3,ff4,cc] Eps[aa,bb,cc] Eps[jj,nn] Eps[kk,mm]
  HC[CC[QL][sp1,jj,ff1,aa]].Ga[0,sp1,sp2].QL[sp2,kk,ff2,bb],
  FlavorExpand->{SU2D} ];

aux2 = UFOOrder ExpandIndices[ MX^2 Xqqqbar[mm,nn,ff3,ff4,cc] 
  HC[CC[QL][sp1,mm,ff3,cc]].Ga[0,sp1,sp2].LL[sp2,nn,ff4],
  FlavorExpand->{SU2D} ];

aux1 + aux2 + HC[aux1] + HC[aux2]
];
