(* SmeftFR v4.0 - class 11 (dim-5/6 B/L violating) operator: qqu3 *)

LQqqu3 := Module[{sp1,sp2,ff1,ff2,ff3,ff4,aa,bb,cc,jj,kk,aux1,aux2},

aux1 = ExpandIndices[ ToExpression[SMEFT$WB <> "qqu3"][ff1,ff2,ff3,ff4]
  Xqqu[ff3,ff4,cc] Eps[aa,bb,cc] Eps[jj,kk]
  HC[CC[QL][sp1,jj,ff1,aa]].Ga[0,sp1,sp2].QL[sp2,kk,ff2,bb],
  FlavorExpand->{SU2D} ];

aux2 = UFOOrder ExpandIndices[ MX^2 Xqqubar[ff3,ff4,cc] 
  HC[CC[uR][sp1,ff3,cc]].Ga[0,sp1,sp2].lR[sp2,ff4],
  FlavorExpand->{SU2D} ];

aux1 + aux2 + HC[aux1] + HC[aux2]		 
];
