(* SmeftFR v4.0 - class 208 (X phi^4 D^2) operator: Wphi4D2n3 *)

LQWphi4D2n3 := Module[{mu,nu,ii,jj,kk,ll,mm,nn,oo,aux},

aux = I Eps[ii,jj,kk] (Phi8bar[ll] 2 Ta8[ii,ll,mm] Phi8[mm]) (DC[Phi8bar[nn],mu] 2 Ta8[jj,nn,oo] DC[Phi8[oo],nu]) FS[Wi8,mu,nu,kk];
aux = ExpandIndices[ aux, FlavorExpand->{SU2W8,SU2D8} ];

ExpandIndices[ ToExpression[SMEFT$WB <> "Wphi4D2n3"] ] aux /. SMEFTGaugeRules
];
