(* SmeftFR v4.0 - class 205 (X^3 phi^2) operator: W2Bphi2n2 *)

LQW2Bphi2n2 := Module[{ii,jj,kk,ll,mm,mu,nu,ro,al,be,ga,de,aux},

aux = Eps[ii,jj,kk] (Phi8bar[ll] 2 Ta8[ii,ll,mm] Phi8[mm]) (Eps[mu,nu,al,be]/2 HC[FS[B8,al,be]] FS[Wi8,nu,ro,jj] FS[Wi8,mu,ro,kk] + FS[B8,mu,nu] FS[Wi8,nu,ro,jj] Eps[mu,ro,ga,de]/2 HC[FS[Wi8,ga,de,kk]]);
aux = ExpandIndices[ aux, FlavorExpand->{SU2W8,SU2D8} ];

ExpandIndices[ ToExpression[SMEFT$WB <> "W2Bphi2n2"] ] aux /. SMEFTGaugeRules
];
