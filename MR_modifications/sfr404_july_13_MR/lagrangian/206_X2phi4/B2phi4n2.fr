(* SmeftFR v4.0 - class 206 (X^2 phi^4) operator: B2phi4n2 *)

LQB2phi4n2 := Module[{ii,jj,mu,nu,al,be,aux},

aux = Phi8bar[ii].Phi8[ii] Phi8bar[jj].Phi8[jj] Eps[mu,nu,al,be]/2 HC[FS[B8,al,be]] FS[B8,mu,nu];
aux = ExpandIndices[ aux, FlavorExpand->{SU2W8,SU2D8} ];

ExpandIndices[ ToExpression[SMEFT$WB <> "B2phi4n2"] ] aux /.SMEFTGaugeRules
];
