(* SmeftFR v4.0 - class 206 (X^2 phi^4) operator: W2phi4n2 *)

LQW2phi4n2 := Module[{ii,jj,mu,nu,al,be,ll,aux},

aux = Phi8bar[ii].Phi8[ii] Phi8bar[jj].Phi8[jj] Eps[mu,nu,al,be]/2 HC[FS[Wi8,al,be,ll]] FS[Wi8,mu,nu,ll];
aux = ExpandIndices[ aux, FlavorExpand->{SU2W8,SU2D8} ];

ExpandIndices[ ToExpression[SMEFT$WB <> "W2phi4n2"] ] aux /. SMEFTGaugeRules
];
