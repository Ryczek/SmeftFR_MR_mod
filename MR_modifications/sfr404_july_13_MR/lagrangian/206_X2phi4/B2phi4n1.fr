(* SmeftFR v4.0 - class 206 (X^2 phi^4) operator: B2phi4n1 *)

LQB2phi4n1 := Module[{ii,jj,mu,nu,aux},

aux = Phi8bar[ii].Phi8[ii] Phi8bar[jj].Phi8[jj] FS[B8,mu,nu] FS[B8,mu,nu];
aux = ExpandIndices[ aux, FlavorExpand->{SU2W8,SU2D8} ];

ExpandIndices[ ToExpression[SMEFT$WB <> "B2phi4n1"] ] aux /. SMEFTGaugeRules
];
