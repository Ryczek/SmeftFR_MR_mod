aux = (FS[B8,mu,nu] Eps[mu,nu,al,be]/2 HC[FS[Wi8,al,be,ii]]) (FS[B8,ro,si] Eps[ro,si,ga,de]/2 HC[FS[Wi8,ga,de,ii]]);
