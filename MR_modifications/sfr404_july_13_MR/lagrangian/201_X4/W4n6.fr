(* SmeftFR v4.0 - class 201 (X^4) operator: W4n6 *)

LQW4n6 := Module[{ii,jj,mu,nu,ro,si,ga,de,aux},

aux = (FS[Wi8,mu,nu,ii] FS[Wi8,mu,nu,jj]) (FS[Wi8,ro,si,ii] Eps[ro,si,ga,de]/2 HC[FS[Wi8,ga,de,jj]]);
aux = ExpandIndices[ aux, FlavorExpand->SU2W8 ];

ExpandIndices[ ToExpression[SMEFT$WB <> "W4n6"] aux ] /. SMEFTGaugeRules
];
