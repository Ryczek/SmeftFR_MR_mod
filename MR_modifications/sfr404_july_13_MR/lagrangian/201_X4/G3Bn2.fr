(* SmeftFR v4.0 - class 201 (X^4) operator: G3Bn2 *)

LQG3Bn2 := Module[{mu,nu,ro,si,al,be,ga,de,aa,bb,cc,aux},

aux = dSUN[aa,bb,cc] (FS[B8,mu,nu] Eps[mu,nu,al,be]/2 HC[FS[Gl8,al,be,aa]]) (FS[Gl8,ro,si,bb] Eps[ro,si,ga,de]/2 HC[FS[Gl8,ga,de,cc]]);
aux = ExpandIndices[ aux, FlavorExpand->SU2W8 ];

ExpandIndices[ ToExpression[SMEFT$WB <> "G3Bn2"] aux ] /. SMEFTGaugeRules
];
