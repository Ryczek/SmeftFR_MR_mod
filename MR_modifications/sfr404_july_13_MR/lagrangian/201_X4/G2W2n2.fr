(* SmeftFR v4.0 - class 201 (X^4) operator: G2W2n2 *)

LQG2W2n2 := Module[{aa,ii,mu,nu,ro,si,al,be,ga,de,aux},

aux = (FS[Wi8,mu,nu,ii] Eps[mu,nu,al,be]/2 HC[FS[Wi8,al,be,ii]]) (FS[Gl8,ro,si,aa] Eps[ro,si,ga,de]/2 HC[FS[Gl8,ga,de,aa]]);
aux = ExpandIndices[ aux, FlavorExpand->SU2W8 ];

ExpandIndices[ ToExpression[SMEFT$WB <> "G2W2n2"] aux ] /. SMEFTGaugeRules
];
