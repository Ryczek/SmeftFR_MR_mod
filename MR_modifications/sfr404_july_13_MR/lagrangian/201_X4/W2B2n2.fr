(* SmeftFR v4.0 - class 201 (X^4) operator: W2B2n2 *)

LQW2B2n2 := Module[{ii,mu,nu,ro,si,al,be,ga,de,aux},

aux = (FS[B8,mu,nu] Eps[mu,nu,al,be]/2 HC[FS[B8,al,be]]) (FS[Wi8,ro,si,ii] Eps[ro,si,ga,de]/2 HC[FS[Wi8,ga,de,ii]]);
aux = ExpandIndices[ aux, FlavorExpand->SU2W8 ];

ExpandIndices[ ToExpression[SMEFT$WB <> "W2B2n2"] aux ] /. SMEFTGaugeRules
];
