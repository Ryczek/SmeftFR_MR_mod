(* SmeftFR v4.0 - class 201 (X^4) operator: G3Bn4 *)

LQG3Bn4 := Module[{mu,nu,ro,si,ga,de,aa,bb,cc,aux},

aux = dSUN[aa,bb,cc] (FS[B8,mu,nu] FS[Gl8,mu,nu,aa]) (FS[Gl8,ro,si,bb] Eps[ro,si,ga,de]/2 HC[FS[Gl8,ga,de,cc]]);
aux = ExpandIndices[ aux, FlavorExpand->SU2W8 ];

ExpandIndices[ ToExpression[SMEFT$WB <> "G3Bn4"] aux ] /. SMEFTGaugeRules
];
