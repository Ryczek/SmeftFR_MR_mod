(* SmeftFR v4.0 - class 201 (X^4) operator: G3Bn1 *)

(* X^3 X' class operators *)

LQG3Bn1 := Module[{mu,nu,ro,si,aa,bb,cc,aux},

aux = dSUN[aa,bb,cc] (FS[B8,mu,nu] FS[Gl8,mu,nu,aa]) (FS[Gl8,ro,si,bb] FS[Gl8,ro,si,cc]);
aux = ExpandIndices[ aux, FlavorExpand->SU2W8 ];

ExpandIndices[ ToExpression[SMEFT$WB <> "G3Bn1"] aux ] /. SMEFTGaugeRules
];
