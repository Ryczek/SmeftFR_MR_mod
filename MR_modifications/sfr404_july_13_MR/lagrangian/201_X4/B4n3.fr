(* SmeftFR v4.0 - class 201 (X^4) operator: B4n3 *)

LQB4n3 := Module[{mu,nu,ro,si,ga,de,aux},

aux = (FS[B8,mu,nu] FS[B8,mu,nu]) (FS[B8,ro,si] Eps[ro,si,ga,de]/2 HC[FS[B8,ga,de]]);
aux = ExpandIndices[ aux, FlavorExpand->SU2W8 ];

ExpandIndices[ ToExpression[SMEFT$WB <> "B4n3"] aux ] /. SMEFTGaugeRules
];
