(* SmeftFR v4.0 - class 201 (X^4) operator: B4n2 *)

LQB4n2 := Module[{mu,nu,ro,si,al,be,ga,de,aux},

aux = (FS[B8,mu,nu] Eps[mu,nu,al,be]/2 HC[FS[B8,al,be]]) (FS[B8,ro,si] Eps[ro,si,ga,de]/2 HC[FS[B8,ga,de]]);
aux = ExpandIndices[ aux, FlavorExpand->SU2W8 ];

ExpandIndices[ ToExpression[SMEFT$WB <> "B4n2"] aux ] /. SMEFTGaugeRules
];
