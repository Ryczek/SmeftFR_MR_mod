(* SmeftFR v4.0 - class 201 (X^4) operator: W4n2 *)

LQW4n2 := Module[{ii,jj,mu,nu,ro,si,al,be,ga,de,aux},

aux = (FS[Wi8,mu,nu,ii] Eps[mu,nu,al,be]/2 HC[FS[Wi8,al,be,ii]]) (FS[Wi8,ro,si,jj] Eps[ro,si,ga,de]/2 HC[FS[Wi8,ga,de,jj]]);
aux = ExpandIndices[ aux, FlavorExpand->SU2W8 ];

ExpandIndices[ ToExpression[SMEFT$WB <> "W4n2"] aux ] /. SMEFTGaugeRules
];
