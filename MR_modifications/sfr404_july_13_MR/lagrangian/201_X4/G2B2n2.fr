(* SmeftFR v4.0 - class 201 (X^4) operator: G2B2n2 *)

LQG2B2n2 := Module[{aa,mu,nu,ro,si,al,be,ga,de,aux},

aux = (FS[B8,mu,nu] Eps[mu,nu,al,be]/2 HC[FS[B8,al,be]]) (FS[Gl8,ro,si,aa] Eps[ro,si,ga,de]/2 HC[FS[Gl8,ga,de,aa]]);
aux = ExpandIndices[ aux, FlavorExpand->SU2W8 ];

ExpandIndices[ ToExpression[SMEFT$WB <> "G2B2n2"] aux ] /. SMEFTGaugeRules
];
