(* SmeftFR v4.0 - class 201 (X^4) operator: G3Bn3 *)

LQG3Bn3 := Module[{mu,nu,ro,si,al,be,aa,bb,cc,aux},

aux = dSUN[aa,bb,cc] (FS[B8,mu,nu] Eps[mu,nu,al,be]/2 HC[FS[Gl8,al,be,aa]]) (FS[Gl8,ro,si,bb] FS[Gl8,ro,si,cc]);
aux = ExpandIndices[ aux, FlavorExpand->SU2W8 ];

ExpandIndices[ ToExpression[SMEFT$WB <> "G3Bn3"] aux ] /. SMEFTGaugeRules
];
