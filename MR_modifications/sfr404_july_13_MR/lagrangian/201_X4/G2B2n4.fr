(* SmeftFR v4.0 - class 201 (X^4) operator: G2B2n4 *)

LQG2B2n4 := Module[{aa,mu,nu,ro,si,al,be,ga,de,aux},

aux = (FS[B8,mu,nu] Eps[mu,nu,al,be]/2 HC[FS[Gl8,al,be,aa]]) (FS[B8,ro,si] Eps[ro,si,ga,de]/2 HC[FS[Gl8,ga,de,aa]]);
aux = ExpandIndices[ aux, FlavorExpand->SU2W8 ];

ExpandIndices[ ToExpression[SMEFT$WB <> "G2B2n4"] aux ] /. SMEFTGaugeRules
];
