aux = (QLbar[sp1,ii,ff1,cc1].uR[sp1,ff2,cc2]).(QLbar[sp2,jj,ff3,dd1].dR[sp2,ff4,dd2]) T[a,cc1,cc2] T[a,dd1,dd2] Eps[ii,jj];
